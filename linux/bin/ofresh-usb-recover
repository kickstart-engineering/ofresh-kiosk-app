#!/usr/bin/env bash
#
# Force the CH340 USB-serial bridge off and back onto the bus.
#
# This is the rung of the error-31 escalation ladder that Windows does not
# have. There, the only tool that reliably re-enumerates a CH340 stuck off the
# bus is a full reboot, which costs ~90 seconds of kiosk downtime. On Linux the
# same effect is available in about five seconds by unbinding the device from
# the usb driver and binding it back.
#
# Runs as root, from ofresh-recovery. Exits 0 if the serial device came back.

set -euo pipefail

VID="${OFRESH_MDB_VID:-1a86}"
PID="${OFRESH_MDB_PID:-7523}"
DEVICE="${OFRESH_MDB_DEVICE:-/dev/ofresh-mdb}"

USB_DRIVER_DIR=/sys/bus/usb/drivers/usb
SETTLE_SECONDS=2
REAPPEAR_TIMEOUT=15

log() { printf '%s\n' "$*"; }

# Every USB port path whose device matches our VID:PID. Interfaces (1-1:1.0)
# carry no idVendor and are skipped, which is what we want -- unbind takes the
# device path, not the interface path.
find_ports() {
    local dev vendor product
    for dev in /sys/bus/usb/devices/*; do
        [ -e "$dev/idVendor" ] || continue
        [ -e "$dev/idProduct" ] || continue
        vendor="$(cat "$dev/idVendor")"
        product="$(cat "$dev/idProduct")"
        if [ "$vendor" = "$VID" ] && [ "$product" = "$PID" ]; then
            basename "$dev"
        fi
    done
}

mapfile -t ports < <(find_ports)

if [ "${#ports[@]}" -eq 0 ]; then
    log "No USB device matching $VID:$PID is present; nothing to rebind"
    exit 1
fi

if [ ! -w "$USB_DRIVER_DIR/unbind" ]; then
    log "$USB_DRIVER_DIR/unbind is not writable; must run as root"
    exit 1
fi

for port in "${ports[@]}"; do
    log "Rebinding USB device $port ($VID:$PID)"

    if ! printf '%s' "$port" > "$USB_DRIVER_DIR/unbind" 2>/dev/null; then
        log "Failed to unbind $port"
        continue
    fi

    sleep "$SETTLE_SECONDS"

    if ! printf '%s' "$port" > "$USB_DRIVER_DIR/bind" 2>/dev/null; then
        log "Failed to bind $port back; the device will need a physical replug or a reboot"
        continue
    fi

    log "Rebound $port"
done

# Rebinding is not the goal in itself -- the serial node coming back is. udev
# has to re-run its rules and recreate the symlink, so give it a moment.
log "Waiting up to ${REAPPEAR_TIMEOUT}s for $DEVICE"

for _ in $(seq "$REAPPEAR_TIMEOUT"); do
    if [ -e "$DEVICE" ]; then
        log "$DEVICE is back; USB recovery succeeded"
        exit 0
    fi
    sleep 1
done

log "$DEVICE did not reappear within ${REAPPEAR_TIMEOUT}s; USB recovery failed"
exit 1
