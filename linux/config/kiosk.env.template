# OFresh kiosk configuration.
#
# Installed to /etc/ofresh/kiosk.env as root:<kiosk-user> 0640 and read by the
# systemd units via EnvironmentFile=. This replaces copying .env into
# %APPDATA% on Windows, where it landed with default ACLs.
#
# Note: systemd parses this file itself, not a shell. No command substitution,
# no variable expansion, no quoting tricks -- literal KEY=value only.

# --- Supervision -------------------------------------------------------------

# The user unit the liveness check restarts.
OFRESH_APP_UNIT=ofresh-kiosk.service

# The log the application writes. Its staleness is the liveness signal, exactly
# as on Windows (C:\logs\main.log). The path is a contract with the ofresh-kiosk
# repo; change it in one place here if the app writes somewhere else.
OFRESH_MAIN_LOG=/var/log/ofresh/main.log

# Treat the app as hung if the log has not been touched for this long.
# Matches the 3 minutes hardcoded in ensure_app_running.ps1.
OFRESH_LOG_STALE_SECONDS=180

# After we restart the app, its log is stale until the new instance writes its
# first entry. Ignore staleness for this long afterwards, or a silent app gets
# killed on every single pass.
OFRESH_START_GRACE_SECONDS=300

# Set to 0 once the app supports sd_notify and ofresh-kiosk.service has been
# switched to Type=notify + WatchdogSec. systemd then owns liveness directly.
OFRESH_LIVENESS_ENABLED=1

# --- Recovery ----------------------------------------------------------------

# The signal the app drops when in-app USB re-enumeration cannot clear the
# fault. On tmpfs deliberately: it cannot outlive the boot that produced it.
OFRESH_REBOOT_REQUEST=/run/ofresh/reboot-request.json

# Persistent state. Must survive reboots -- it is what stops a reboot loop.
OFRESH_STATE_DIR=/var/lib/ofresh

# Ignore a reboot request older than this.
OFRESH_REBOOT_REQUEST_MAX_AGE_SECONDS=300

# Never reboot more often than this, however many requests arrive.
OFRESH_MIN_SECONDS_BETWEEN_REBOOTS=900

# --- Serial hardware ---------------------------------------------------------

# CH340/CH341 USB-serial bridge carrying the MDB interface.
OFRESH_MDB_VID=1a86
OFRESH_MDB_PID=7523

# Stable name from 99-ofresh-serial.rules. Never use /dev/ttyUSB0 directly:
# it races the door-lock adapter for enumeration order.
OFRESH_MDB_DEVICE=/dev/ofresh-mdb

# Stable name for the fridge relay, created by 99-ofresh-serial.rules on the
# reference CP2102 hardware. Override this for a different relay adapter.
FRIDGE_RELAY_PORT=/dev/ofresh-lock

# --- Application ------------------------------------------------------------
# Carried over from .env.template. LICENCESE_KEY is misspelled there too; the
# name is kept byte-for-byte because the application reads it.

MACHINE_ID=
LICENCESE_KEY=
KIOSK_SERVICE_HOST=
DWAGENT_USER=
DWAGENT_PASS=

# --- Updates ----------------------------------------------------------------

# The systemd pre-start updater can install an AppImage when none exists and
# supports an independent fridge version line (including the initial downgrade
# from legacy 1.x builds). Use a fine-grained, read-only token because the
# fridge release repository is private. The authenticated gh CLI is used as a
# local-development fallback when this is empty.
OFRESH_UPDATE_ENABLED=1
OFRESH_UPDATE_REPOSITORY=kickstart-engineering/ofresh-kiosk
OFRESH_UPDATE_TAG_PREFIX=fridge-v
OFRESH_UPDATE_CHECK_INTERVAL_SECONDS=300
OFRESH_UPDATE_TOKEN=
