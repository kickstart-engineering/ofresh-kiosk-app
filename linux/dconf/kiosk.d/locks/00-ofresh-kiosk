# Make the kiosk settings above un-settable from inside the session.
#
# Without these locks the values are only defaults: anything running as the
# kiosk user -- including a customer who reaches a settings panel -- can
# override them, and the screen starts blanking again.

/org/gnome/desktop/session/idle-delay
/org/gnome/desktop/screensaver/lock-enabled
/org/gnome/desktop/screensaver/idle-activation-enabled
/org/gnome/settings-daemon/plugins/power/sleep-inactive-ac-type
/org/gnome/settings-daemon/plugins/power/sleep-inactive-battery-type
/org/gnome/settings-daemon/plugins/power/idle-dim
/org/gnome/settings-daemon/plugins/power/power-button-action
/org/gnome/desktop/interface/enable-hot-corners
/org/gnome/mutter/overlay-key
/org/gnome/mutter/edge-tiling
/org/gnome/shell/disable-user-extensions
/org/gnome/desktop/a11y/applications/screen-keyboard-enabled
/org/gnome/desktop/notifications/show-banners
/org/gnome/desktop/notifications/show-in-lock-screen
/org/gnome/desktop/media-handling/automount-open
/org/gnome/desktop/media-handling/autorun-never
