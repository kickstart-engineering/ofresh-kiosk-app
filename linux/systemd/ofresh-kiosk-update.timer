[Unit]
Description=Daily OFresh kiosk application update check
Documentation=https://github.com/kickstart-engineering/ofresh-kiosk-app

[Timer]
# Runs at 03:00 local time. Persistent catches up immediately when the kiosk
# starts after missing the scheduled time because it was powered off.
OnCalendar=*-*-* 03:00:00
Persistent=true
AccuracySec=1min

[Install]
WantedBy=timers.target
